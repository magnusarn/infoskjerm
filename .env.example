# Kopier til .env.local for lokal kjøring, eller legg inn i Vercel → Settings → Environment Variables.
# Ingen av disse trengs for Yr, Ruter og nyheter.

# Beskytter skjermer med private: true (kontor-2). Lang, tilfeldig streng.
SCREEN_KEY=
# Valgfri IP-sperre for låste skjermer. Kommaseparert, f.eks. 84.208.1.2 eller 193.69.0.0/24.
# Finn kontorets adresse ved å åpne /api/min-ip fra kontorets nettverk.
ALLOWED_IPS=

# Identifikasjon mot API-ene (påkrevd av MET og Entur)
MET_USER_AGENT=infoskjerm/1.0 din@epost.no
ENTUR_CLIENT_NAME=dittnavn-infoskjerm

# Kalender: publisert ICS-lenke fra Outlook eller Google
CALENDAR_ICS_URL=

# YouTube: video-ID (fra youtube.com/watch?v=XXXX) eller spilleliste-ID (PL…)
YOUTUBE_VIDEO_ID=

# Power BI «Publiser på nett» eller Looker Studio embed-lenke
POWERBI_EMBED_URL=

# GA4
GA4_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0

# Sett til 1 for å vise eksempeldata på alle skjermer
DEMO=
